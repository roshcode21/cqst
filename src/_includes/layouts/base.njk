<!doctype html>
<html lang="{{ site.language }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="{{ themeColor or '#070812' }}">
  <meta name="format-detection" content="telephone=no">
  <meta name="application-name" content="{{ site.name }}">
  <meta name="apple-mobile-web-app-title" content="{{ site.name }}">

  <title>{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="robots" content="{{ robots or 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1' }}">
  <link rel="canonical" href="{{ canonical or (site.url + page.url) }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="{{ site.url }}/feed.xml">

  <meta property="og:locale" content="es_MX">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ ogTitle or title or site.name }}">
  <meta property="og:description" content="{{ ogDescription or description or site.description }}">
  <meta property="og:url" content="{{ canonical or (site.url + page.url) }}">
  {% if shareImage %}<meta property="og:image" content="{{ site.url }}{{ shareImage }}">{% endif %}
  {% if shareImage %}<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">{% endif %}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle or title or site.name }}">
  <meta name="twitter:description" content="{{ ogDescription or description or site.description }}">
  {% if shareImage %}<meta name="twitter:image" content="{{ site.url }}{{ shareImage }}">{% endif %}

  <link rel="icon" href="/assets/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png" sizes="180x180">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="stylesheet" href="/assets/css/production/base.css">
  {% if stylesheet %}<link rel="stylesheet" href="{{ stylesheet }}">{% endif %}

  {% block head %}{% endblock %}
</head>
<body class="{{ bodyClass or '' }}">
  <a class="skip-link" href="#main">Saltar al contenido</a>
  {% block body %}{% endblock %}
  <script>document.documentElement.classList.remove('no-js');document.documentElement.classList.add('js');</script>
  {% if script %}<script defer src="{{ script }}"></script>{% endif %}
  {% block scripts %}{% endblock %}
</body>
</html>
