<footer class="article-footer" aria-label="Pie de página">
  <div class="article-footer__inner">
    <div class="article-footer__brand">
      <a href="/" class="article-footer__logo" aria-label="Ir a la portada">
        <img src="/assets/brand/logo-static.png" alt="{{ site.name }}">
      </a>
      <p>{{ site.description }}</p>
    </div>

    <div class="article-footer__navs">
      <nav aria-label="Explorar">
        <strong>Explorar</strong>
        <a href="/">Portada</a>
        <a href="/temas/">Temas</a>
        <a href="/cqst/">Conocer</a>
      </nav>
      <nav aria-label="Seguir">
        <strong>Seguir</strong>
        <a href="{{ site.social.instagram }}" target="_blank" rel="me noopener">Instagram ↗</a>
        <a href="{{ site.social.tiktok }}" target="_blank" rel="me noopener">TikTok ↗</a>
        <a href="{{ site.social.facebook }}" target="_blank" rel="me noopener">Facebook ↗</a>
      </nav>
      <nav aria-label="Utilidades">
        <strong>Más</strong>
        <a href="/feed.xml">RSS</a>
        <a href="/privacidad/">Privacidad</a>
        <a href="#main">Arriba ↑</a>
      </nav>
    </div>

    <div class="article-footer__meta">
      <span>© 2026 {{ site.name }}</span>
      <span>{{ site.tagline }}</span>
    </div>
  </div>

  <div class="last-pixel" aria-label="Final de lectura">
    <span class="last-pixel__pattern" aria-hidden="true"></span>
    <span class="last-pixel__phrase">Una lectura nunca tiene la última palabra.</span>
  </div>
</footer>
