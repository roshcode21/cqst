<div class="chevron-divider scene{% if variant %} chevron-divider--{{ variant }}{% endif %}" data-scene="{{ scene }}" data-tone="dark" aria-hidden="true">
  <span class="chevron-divider__field chevron-divider__field--left matrix">&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;</span>
  <span class="chevron-divider__spark">✦</span>
  <span class="chevron-divider__field chevron-divider__field--right matrix">&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;</span>
</div>
