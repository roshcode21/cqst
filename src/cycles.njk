---
pagination:
  data: cyclePages
  size: 1
  alias: cyclePage
permalink: "/{{ cyclePage.cycle.slug }}/index.html"
robots: "noindex,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
stylesheet: "/assets/css/production/cycle.css"
script: "/assets/js/production/cycle.js"
eleventyComputed:
  seoTitle: "{{ cyclePage.cycle.seoTitle }}"
  title: "{{ cyclePage.cycle.title }}"
  description: "{{ cyclePage.cycle.description }}"
  canonical: "{{ site.url }}/{{ cyclePage.cycle.slug }}/"
  shareImage: "{{ cyclePage.cycle.shareImage }}"
  shareImageAlt: "{{ cyclePage.cycle.shareImageAlt }}"
  themeColor: "{{ cyclePage.cycle.themeColor }}"
  bodyClass: "cycle-page cycle-page--{{ cyclePage.cycle.visualTheme }}"
---
{% extends "layouts/base.njk" %}

{% block head %}
<meta data-pagefind-meta="type:cycle">
<meta data-pagefind-meta="cycle:{{ cyclePage.cycle.title }}">
<meta data-pagefind-filter="type:cycle">
<meta data-pagefind-filter="cycle:{{ cyclePage.cycle.title }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "{{ site.url }}/{{ cyclePage.cycle.slug }}/#page",
      "url": "{{ site.url }}/{{ cyclePage.cycle.slug }}/",
      "name": {{ cyclePage.cycle.title | json | safe }},
      "description": {{ cyclePage.cycle.description | json | safe }},
      "inLanguage": "{{ site.locale }}",
      "isPartOf": {"@id": "{{ site.url }}/#website"},
      "mainEntity": {"@id": "{{ site.url }}/{{ cyclePage.cycle.slug }}/#cycle"}
    },
    {
      "@type": "CreativeWorkSeries",
      "@id": "{{ site.url }}/{{ cyclePage.cycle.slug }}/#cycle",
      "name": {{ cyclePage.cycle.title | json | safe }},
      "description": {{ cyclePage.cycle.deck | json | safe }},
      "url": "{{ site.url }}/{{ cyclePage.cycle.slug }}/",
      "inLanguage": "{{ site.locale }}",
      "dateCreated": "{{ cyclePage.cycle.dateStart }}",
      "dateModified": "{{ cyclePage.dateModified }}",
      "publisher": {"@id": "{{ site.url }}/#organization"},
      "keywords": {{ cyclePage.keywords | json | safe }},
      "hasPart": [
        {% for piece in cyclePage.publishedPieces %}
        {
          "@type": "Article",
          "name": {{ piece.title | json | safe }},
          "url": "{{ site.url }}{{ piece.href }}",
          "author": {"@type": "Person", "name": {{ piece.author | json | safe }}}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    },
    {
      "@type": "ItemList",
      "@id": "{{ site.url }}/{{ cyclePage.cycle.slug }}/#pieces",
      "name": "Piezas publicadas de {{ cyclePage.cycle.title }}",
      "numberOfItems": {{ cyclePage.publishedPieces.length }},
      "itemListElement": [
        {% for piece in cyclePage.publishedPieces %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "url": "{{ site.url }}{{ piece.href }}",
          "name": {{ piece.title | json | safe }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type":"ListItem","position":1,"name":"Portada","item":"{{ site.url }}/"},
        {"@type":"ListItem","position":2,"name":"Temas","item":"{{ site.url }}/temas/"},
        {"@type":"ListItem","position":3,"name":{{ cyclePage.cycle.title | json | safe }},"item":"{{ site.url }}/{{ cyclePage.cycle.slug }}/"}
      ]
    }
  ]
}
</script>
{% endblock %}

{% block body %}
{% set cycle = cyclePage.cycle %}
{% set navCurrent = "temas" %}
{% include "components/interior-nav.njk" %}

<main id="main" data-pagefind-body style="--cycle-hero-image:url('{{ cycle.art.heroBackground }}');--cycle-closing-image:url('{{ cycle.art.closingBackground }}')">
  <section class="cycle-hero" aria-labelledby="cycleTitle">
    <div class="cycle-hero__orbit" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="cycle-hero__shell">
      <p class="cycle-hero__crumb matrix"><a href="/temas/">TEMAS</a><span>/</span><strong>{{ cycle.title | upper }}</strong></p>

      <div class="cycle-hero__title-wrap">
        <h1 id="cycleTitle">{{ cycle.title }}</h1>
        <span class="cycle-hero__spark" aria-hidden="true">✦</span>
      </div>

      <div class="cycle-hero__copy">
        <p class="cycle-hero__premise">{{ cycle.deck }}</p>
        <p class="cycle-hero__intro">{{ cycle.copy.intro }}</p>
      </div>

      <nav class="cycle-rail" aria-label="Piezas del ciclo {{ cycle.title }}">
        <div class="cycle-rail__head">
          <p class="cycle-rail__label matrix">{{ cycle.title | upper }} / {% if cyclePage.pieceCount < 10 %}0{% endif %}{{ cyclePage.pieceCount }} PIEZAS</p>
          <div class="cycle-rail__controls" aria-label="Mover piezas">
            <button type="button" data-cycle-rail-prev aria-label="Ver piezas anteriores">←</button>
            <button type="button" data-cycle-rail-next aria-label="Ver piezas siguientes">→</button>
          </div>
          <p class="cycle-rail__cue matrix" aria-live="polite"><span data-cycle-rail-current>01</span> / {% if cyclePage.railPieces.length < 10 %}0{% endif %}{{ cyclePage.railPieces.length }} — DESLIZA →</p>
        </div>

        <div class="cycle-rail__viewport">
          <div class="cycle-rail__track" data-cycle-rail-track>
            {% for piece in cyclePage.railPieces %}
            <a class="cycle-rail__item" href="#piece-{{ piece.order }}" data-cycle-rail-item{% if not piece.isPublished %} data-pagefind-ignore="all"{% endif %}>
              <span class="cycle-rail__number matrix">{% if piece.order < 10 %}0{% endif %}{{ piece.order }}</span>
              <span class="cycle-rail__copy">
                <strong>{{ piece.title }}</strong>
                <small>{{ piece.author }}</small>
              </span>
              <span class="cycle-rail__arrow" aria-hidden="true">↘</span>
            </a>
            {% endfor %}
          </div>
        </div>
        <div class="cycle-rail__meter" aria-hidden="true"><i data-cycle-rail-meter></i></div>
        {% if cyclePage.railIsCurated %}<a class="cycle-rail__all" href="#piecesTitle">Ver las {{ cyclePage.pieceCount }} piezas ↓</a>{% endif %}
      </nav>
    </div>
  </section>

  <section class="cycle-pieces" aria-labelledby="piecesTitle">
    <header class="cycle-pieces__head">
      <div>
        <p class="matrix">ARCHIVO / {{ cycle.title | upper }}</p>
        <h2 id="piecesTitle">{{ cycle.copy.piecesHeading }}</h2>
      </div>
      <p>{{ cycle.copy.piecesDeck }}</p>
    </header>

    <div class="cycle-pieces__list">
      {% for piece in cyclePage.pieces %}
      <article class="cycle-piece" id="piece-{{ piece.order }}"{% if not piece.isPublished %} data-pagefind-ignore="all"{% endif %}>
        <a class="cycle-piece__link" href="{{ piece.href }}"{% if not piece.isPublished %} data-preview-link="true"{% endif %}>
          <span class="cycle-piece__number matrix" aria-hidden="true">{% if piece.order < 10 %}0{% endif %}{{ piece.order }}</span>
          <div class="cycle-piece__main">
            <h3>{{ piece.title }}</h3>
            {% if piece.excerpt %}<p class="cycle-piece__excerpt">{{ piece.excerpt }}</p>{% endif %}
          </div>
          <div class="cycle-piece__meta">
            <strong>{{ piece.author }}</strong>
            {% if piece.dateLabel %}<span>{{ piece.dateLabel }}</span>{% endif %}
            <span>{% if piece.genre %}{{ piece.genre }}{% endif %}{% if piece.genre and piece.readingTime %} · {% endif %}{% if piece.readingTime %}{{ piece.readingTime }} min{% endif %}</span>
          </div>
          <span class="cycle-piece__arrow" aria-hidden="true">↗</span>
        </a>
      </article>
      {% endfor %}
    </div>
  </section>

  <section class="cycle-closing" aria-labelledby="closingTitle">
    <div class="cycle-closing__inner">
      <div class="cycle-closing__head">
        <img class="cycle-closing__mark" src="/assets/ciclos.png" alt="" aria-hidden="true">
        <p class="matrix">{{ cycle.copy.closingKicker }}</p>
      </div>
      <h2 id="closingTitle">{{ cycle.copy.closingTitle }}</h2>
      <p>{{ cycle.copy.closingBody }}</p>
      {% if cyclePage.hasOtherCycles %}
        <a href="/temas/">{{ cycle.copy.moreCyclesLabel }} →</a>
      {% else %}
        <a href="/">{{ cycle.copy.homeLabel }} →</a>
      {% endif %}
    </div>
  </section>
</main>

<section class="cycle-newsletter" aria-labelledby="cycleNewsletterTitle">
  <div class="cycle-newsletter__inner">
    <div class="cycle-newsletter__copy">
      <p class="matrix">SUSCRIPCIÓN</p>
      <h2 id="cycleNewsletterTitle">Que el próximo tema te encuentre.</h2>
      <p>Un correo cuando haya algo que decir.</p>
    </div>
    <div class="cycle-newsletter__action">
      <form class="cycle-newsletter__form" data-cycle-newsletter action="https://formspree.io/f/{{ site.formspreeId }}" method="POST">
        <label class="sr-only" for="cycleNewsletterEmail-{{ cycle.slug }}">Tu correo</label>
        <input id="cycleNewsletterEmail-{{ cycle.slug }}" name="email" type="email" placeholder="tu correo" required autocomplete="email">
        <input type="hidden" name="_subject" value="Nueva suscripción — Ciclo {{ cycle.title }}">
        <input type="hidden" name="form_type" value="suscripcion">
        <input type="hidden" name="origen" value="Ciclo {{ cycle.title }}">
        <button type="submit">Recibir →</button>
      </form>
      <p class="cycle-newsletter__note" data-cycle-newsletter-note aria-live="polite"></p>
      <a class="cycle-newsletter__privacy" href="/privacidad/">Privacidad</a>
    </div>
  </div>
</section>

{% include "components/interior-footer.njk" %}
{% endblock %}
