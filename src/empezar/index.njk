---
seoTitle: "Empezar — textos y voces sobre los comienzos | Cada Quien Su Tema"
title: "Empezar"
description: "Empezar reúne textos y voces que vuelven sobre lo que significa reconocer, elegir, recordar o inventar un comienzo."
robots: "noindex,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
canonical: "https://cadaquiensutema.com/empezar/"
shareImage: "/assets/brand/share-empezar-1200x630.png"
shareImageAlt: "Empezar, ciclo editorial de Cada Quien Su Tema"
themeColor: "#c8ff64"
stylesheet: "/assets/css/production/cycle.css"
bodyClass: "cycle-page cycle-page--empezar"
permalink: "/empezar/index.html"
---
{% extends "layouts/base.njk" %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "{{ site.url }}/empezar/#page",
      "url": "{{ site.url }}/empezar/",
      "name": "Empezar",
      "description": {{ description | json | safe }},
      "inLanguage": "{{ site.locale }}",
      "isPartOf": {"@id": "{{ site.url }}/#website"},
      "mainEntity": {"@id": "{{ site.url }}/empezar/#cycle"}
    },
    {
      "@type": "CreativeWorkSeries",
      "@id": "{{ site.url }}/empezar/#cycle",
      "name": "Empezar",
      "description": {{ empezar.cycle.deck | json | safe }},
      "url": "{{ site.url }}/empezar/",
      "inLanguage": "{{ site.locale }}",
      "publisher": {"@id": "{{ site.url }}/#organization"},
      "keywords": ["comienzos", "memoria", "relato", "experiencia", "cambio"],
      "hasPart": [
        {% for piece in empezar.publishedPieces %}
        {
          "@type": "Article",
          "name": {{ piece.title | json | safe }},
          "url": "{{ site.url }}{{ piece.href }}",
          "author": {"@type": "Person", "name": {{ piece.author | json | safe }}}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    },
    {
      "@type": "ItemList",
      "@id": "{{ site.url }}/empezar/#pieces",
      "name": "Piezas publicadas de Empezar",
      "numberOfItems": {{ empezar.publishedPieces.length }},
      "itemListElement": [
        {% for piece in empezar.publishedPieces %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "url": "{{ site.url }}{{ piece.href }}",
          "name": {{ piece.title | json | safe }}
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type":"ListItem","position":1,"name":"Portada","item":"{{ site.url }}/"},
        {"@type":"ListItem","position":2,"name":"Temas","item":"{{ site.url }}/temas/"},
        {"@type":"ListItem","position":3,"name":"Empezar","item":"{{ site.url }}/empezar/"}
      ]
    }
  ]
}
</script>
{% endblock %}

{% block body %}
{% set navCurrent = "temas" %}
{% include "components/interior-nav.njk" %}

<main id="main" data-pagefind-body>
  <section class="cycle-hero" aria-labelledby="cycleTitle">
    <div class="cycle-hero__orbit" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="cycle-hero__shell">
      <div class="cycle-hero__meta" aria-label="Ubicación editorial">
        <a href="/temas/">Temas</a>
        <span aria-hidden="true">/</span>
        <strong>{{ empezar.cycle.title }}</strong>
      </div>

      <div class="cycle-hero__title-wrap">
        <p class="cycle-hero__index matrix">{{ empezar.copy.indexLabel }}</p>
        <h1 id="cycleTitle">{{ empezar.cycle.title }}</h1>
        <span class="cycle-hero__spark" aria-hidden="true">✦</span>
      </div>

      <div class="cycle-hero__copy">
        <p class="cycle-hero__premise">{{ empezar.cycle.deck }}</p>
        <p class="cycle-hero__intro">{{ empezar.copy.intro }}</p>
      </div>

      <nav class="cycle-index" aria-label="Índice de piezas de Empezar">
        <p class="cycle-index__label matrix">ÍNDICE DEL CICLO</p>
        <div class="cycle-index__track">
          {% for piece in empezar.pieces %}
          <a class="cycle-index__item" href="#piece-{{ piece.order }}">
            <span class="cycle-index__number matrix">{% if piece.order < 10 %}0{% endif %}{{ piece.order }}</span>
            <span class="cycle-index__copy"><strong>{{ piece.title }}</strong><small>{{ piece.author }}</small></span>
          </a>
          {% endfor %}
        </div>
      </nav>
    </div>
  </section>

  <section class="cycle-pieces" aria-labelledby="piecesTitle">
    <header class="cycle-pieces__head">
      <div>
        <p class="matrix">{{ empezar.cycle.title | upper }} / ARCHIVO ABIERTO</p>
        <h2 id="piecesTitle">{{ empezar.copy.piecesHeading }}</h2>
      </div>
      <p>{{ empezar.copy.piecesDeck }}</p>
    </header>

    <div class="cycle-pieces__list">
      {% for piece in empezar.pieces %}
      <article class="cycle-piece" id="piece-{{ piece.order }}">
        <a class="cycle-piece__link" href="{{ piece.href }}"{% if not piece.isPublished %} data-preview-link="true"{% endif %}>
          <div class="cycle-piece__number matrix" aria-hidden="true">{% if piece.order < 10 %}0{% endif %}{{ piece.order }}</div>
          <div class="cycle-piece__main">
            <p class="cycle-piece__eyebrow matrix">{{ piece.author }}</p>
            <h3>{{ piece.title }}</h3>
            {% if piece.excerpt %}<p class="cycle-piece__excerpt">{{ piece.excerpt }}</p>{% endif %}
          </div>
          <aside class="cycle-piece__aside">
            <div class="cycle-piece__meta">
              <p class="cycle-piece__author">{{ piece.author }}</p>
              {% if piece.dateLabel %}<p>{{ piece.dateLabel }}</p>{% endif %}
              {% if piece.genre %}<p>{{ piece.genre }}</p>{% endif %}
              {% if piece.readingTime %}<p>{{ piece.readingTime }} min de lectura</p>{% endif %}
            </div>
            <span class="cycle-piece__cta"><span>Leer la pieza</span><b aria-hidden="true">↗</b></span>
          </aside>
          <span class="cycle-piece__pixel cycle-piece__pixel--a" aria-hidden="true"></span>
          <span class="cycle-piece__pixel cycle-piece__pixel--b" aria-hidden="true"></span>
        </a>
      </article>
      {% endfor %}
    </div>
  </section>

  <section class="cycle-closing" aria-labelledby="closingTitle">
    <div class="cycle-closing__mark" aria-hidden="true"><img src="/assets/ciclos.png" alt=""></div>
    <div class="cycle-closing__copy">
      <p class="matrix">UNA IDEA / VARIAS VIDAS</p>
      <h2 id="closingTitle">{{ empezar.copy.closingTitle }}</h2>
      <p>{{ empezar.copy.closingBody }}</p>
      {% if empezar.hasOtherCycles %}
        <a href="/temas/">{{ empezar.copy.moreCyclesLabel }} →</a>
      {% else %}
        <a href="/">{{ empezar.copy.homeLabel }} →</a>
      {% endif %}
    </div>
  </section>
</main>

{% include "components/interior-footer.njk" %}
{% endblock %}
